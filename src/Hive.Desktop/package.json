{
  "name": "hive-desktop",
  "version": "1.0.0",
  "description": "Hive - Engineering Manager Dashboard",
  "author": "Hive Team",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build && electron-builder",
    "preview": "vite preview",
    "electron:dev": "concurrently \"vite\" \"wait-on http://localhost:5173 && electron .\"",
    "electron:build": "npm run build:backend && vite build && electron-builder",
    "electron:build:mac": "npm run build:backend:mac && vite build && electron-builder --mac",
    "electron:build:win": "npm run build:backend:win && vite build && electron-builder --win",
    "build:backend": "../../scripts/build-backend.sh",
    "build:backend:mac": "../../scripts/build-backend.sh osx-arm64",
    "build:backend:win": "../../scripts/build-backend.sh win-x64",
    "build:backend:all": "../../scripts/build-backend.sh all",
    "test": "NODE_NO_WARNINGS=1 vitest run",
    "test:watch": "NODE_NO_WARNINGS=1 vitest",
    "test:ui": "NODE_NO_WARNINGS=1 vitest --ui",
    "test:coverage": "NODE_NO_WARNINGS=1 vitest run --coverage"
  },
  "dependencies": {
    "axios": "^1.6.2",
    "lucide-react": "^0.294.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.20.0",
    "recharts": "^2.10.3"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.1",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^18.2.43",
    "@types/react-dom": "^18.2.17",
    "@vitejs/plugin-react": "^4.2.1",
    "@vitest/coverage-v8": "^4.0.16",
    "autoprefixer": "^10.4.16",
    "concurrently": "^8.2.2",
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1",
    "jsdom": "^27.4.0",
    "msw": "^2.12.7",
    "postcss": "^8.4.32",
    "tailwindcss": "^3.3.6",
    "typescript": "^5.3.3",
    "vite": "^5.0.10",
    "vite-plugin-electron": "^0.15.4",
    "vitest": "^4.0.16",
    "wait-on": "^7.2.0"
  },
  "build": {
    "appId": "com.hive.desktop",
    "productName": "Hive",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*"
    ],
    "extraResources": [
      {
        "from": "backend",
        "to": "backend",
        "filter": [
          "**/*"
        ]
      }
    ],
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "src/assets/icon.icns",
      "category": "public.app-category.developer-tools",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "entitlements.mac.plist",
      "entitlementsInherit": "entitlements.mac.plist",
      "extraResources": [
        {
          "from": "backend/osx-arm64",
          "to": "backend/osx-arm64",
          "filter": [
            "**/*"
          ]
        },
        {
          "from": "backend/osx-x64",
          "to": "backend/osx-x64",
          "filter": [
            "**/*"
          ]
        }
      ]
    },
    "win": {
      "target": [
        "nsis",
        "zip"
      ],
      "icon": "src/assets/icon.ico",
      "signingHashAlgorithms": [
        "sha256"
      ],
      "sign": null,
      "extraResources": [
        {
          "from": "backend/win-x64",
          "to": "backend/win-x64",
          "filter": [
            "**/*"
          ]
        }
      ]
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "src/assets/icon.png",
      "extraResources": [
        {
          "from": "backend/linux-x64",
          "to": "backend/linux-x64",
          "filter": [
            "**/*"
          ]
        }
      ]
    }
  }
}
